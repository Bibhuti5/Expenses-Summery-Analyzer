{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "uigen (Next.js)",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "."
    },
    {
      "name": "multi-agent-dashboard: frontend (Vite)",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "cwd": "."
    },
    {
      "name": "multi-agent-dashboard: backend (FastAPI)",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["main:app", "--reload", "--port", "8000"],
      "port": 8000,
      "cwd": "."
    }
  ]
}
