# ─── Netlify / Deployment ─────────────────────────────────────────────────────
# Auto-set by Netlify on every deploy — do NOT set manually in production.
# NEXT_DEPLOYMENT_ID=<auto>

# Enable Skew Protection (optional). Set to "true" in Netlify environment vars.
# NETLIFY_NEXT_SKEW_PROTECTION=true

# ─── App ──────────────────────────────────────────────────────────────────────
# Base URL of your deployed site (used for OAuth redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Google OAuth (Gmail Finance Tracker) ────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/finance/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Anthropic API ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
